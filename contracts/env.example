# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Private key of the wallet used to deploy (must have 0G tokens for gas).
# Format: 0x prefixed hex string.
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Server hot wallet address — this wallet will call setHashFor() and processValidation().
# Should be a separate key from the deployer in production.
OPERATOR_ADDRESS=your_server_hot_wallet_address_here

# Company treasury wallet — receives approved subscription payments.
# Use a multisig (e.g. Safe/Gnosis) in production.
TREASURY_ADDRESS=your_treasury_multisig_address_here

# 0G Chain RPC endpoints
OG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai
OG_MAINNET_RPC_URL=https://evmrpc.0g.ai

# Block explorer API key (use any placeholder string if you don't have one yet)
OG_ETHERSCAN_API_KEY=your_api_key_here

# After deployment, paste the deployed address here for reference
STORAGE_GATEKEEPER_ADDRESS=
