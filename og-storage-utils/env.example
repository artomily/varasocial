# ============================================================
# 0G Storage TypeScript Starter Kit — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control!

# ------------------------------------------------------------
# Network & Mode
# ------------------------------------------------------------
# Network: "testnet" or "mainnet" (default: testnet)
NETWORK=testnet

# Storage mode: "turbo" or "standard" (default: turbo)
# Turbo  : higher fees, faster & more reliable
# Standard: lower fees (currently under maintenance on some networks)
STORAGE_MODE=turbo

# ------------------------------------------------------------
# Wallet
# ------------------------------------------------------------
# Your EVM private key — needed for uploads (gas fees)
# Get testnet tokens: https://faucet.0g.ai (0.1 0G/day)
# Export from MetaMask: Account Details → Show Private Key
PRIVATE_KEY=your_private_key_here

# ------------------------------------------------------------
# Optional: Gas configuration
# ------------------------------------------------------------
# GAS_PRICE=3000000000000
# GAS_LIMIT=2000000

# ------------------------------------------------------------
# Optional: Retry configuration
# ------------------------------------------------------------
# MAX_RETRIES=3
# MAX_GAS_PRICE=3000000000000

# ------------------------------------------------------------
# 0G-KV (Key-Value Storage)
# ------------------------------------------------------------
# RPC URL of a 0G-KV node — required for kvGet reads.
#
# IMPORTANT: 0G Foundation does NOT provide a public KV node.
# You must either:
#   a) Run your own KV node: https://docs.0g.ai/run-a-node/storage-node
#   b) Use a community-provided endpoint (may be unreliable / offline)
#
# Community endpoints (testnet, not guaranteed to be active):
# KV_RPC_URL=http://3.101.147.150:6789
#
# kvSet (writes) do NOT require KV_RPC_URL — they go through the indexer.
# KV_RPC_URL=http://<your-kv-node-ip>:6789

# Stream ID for your KV store — a 0x-prefixed 32-byte hex string.
# Generate one: node -e "const {ethers}=await import('ethers');console.log(ethers.id('your-app-name'))"
# KV_STREAM_ID=0x<64 hex chars>

# ------------------------------------------------------------
# Optional: Client-side encryption (SDK >= 1.2.2)
# ------------------------------------------------------------
# Files are encrypted before upload — the 0G network never sees plaintext.
# WARNING: losing the key makes data unrecoverable.

# Mode 1 — AES-256 (symmetric). One 32-byte key for encrypt + decrypt.
# ENCRYPTION_MODE=aes256
# ENCRYPTION_KEY=0x<64 hex chars>        # 32-byte key as hex
# DECRYPTION_KEY=0x<64 hex chars>        # same key used to decrypt

# Mode 2 — ECIES (asymmetric secp256k1). Encrypt to a recipient public key.
# ENCRYPTION_MODE=ecies
# RECIPIENT_PUBKEY=0x<compressed 33-byte pubkey hex>
# RECIPIENT_PRIVKEY=0x<privkey hex>      # used for decryption (can reuse PRIVATE_KEY)
