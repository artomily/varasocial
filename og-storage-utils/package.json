{
  "name": "0g-storage-ts-starter",
  "version": "1.0.0",
  "description": "TypeScript starter kit for 0G decentralized storage",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "upload": "tsx scripts/upload.ts",
    "download": "tsx scripts/download.ts",
    "upload:data": "tsx scripts/upload-data.ts",
    "upload:batch": "tsx scripts/batch-upload.ts",
    "kv:set": "tsx scripts/kv-set.ts",
    "kv:get": "tsx scripts/kv-get.ts",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
